OPENAI_API_KEY=your_openai_key_here
SARVAM_API_KEY=your_sarvam_key_here

# Supabase. Required: every endpoint except the health check verifies the
# caller's access token, and transcription job state lives in Postgres so it
# survives across gunicorn workers.
SUPABASE_URL=https://tjhuexhsadigbqbxnxkd.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Set to 1 ONLY for local development. Disables auth on every endpoint.
ALLOW_ANONYMOUS=0
